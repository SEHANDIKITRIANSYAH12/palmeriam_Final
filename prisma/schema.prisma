// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  name          String
  role          String         @default("admin")
  chatSessions  ChatSession[]  @relation("AdminChatSessions")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  berita        Berita[]
}

model Pengaduan {
  id            Int      @id @default(autoincrement())
  ticketId      String   @unique // Format: SIPALMI-YYYYMMDD-XXXX
  judul         String
  deskripsi     String
  status        String   @default("Baru") // Baru, Diproses, Selesai
  prioritas     String   @default("Sedang") // Rendah, Sedang, Tinggi
  pelaporNama   String
  pelaporKontak String?
  pelaporEmail  String?
  lokasi        String?
  kategori      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Berita {
  id          Int      @id @default(autoincrement())
  judul       String
  konten      String
  gambar      String?
  kategori    String
  isPublished Boolean  @default(false)
  penulisId   Int
  penulis     User     @relation(fields: [penulisId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agenda {
  id            Int      @id @default(autoincrement())
  judul         String
  deskripsi     String
  tanggal       DateTime
  waktuMulai    String
  waktuSelesai  String
  lokasi        String
  kategori      String
  peserta       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatSession {
  id            String        @id @default(cuid())
  namaLengkap   String
  noHp          String
  status        String        @default("Aktif") // Aktif, Selesai, Diambil Alih
  diambilAlih   Boolean       @default(false)
  adminId       Int?          // ID admin yang mengambil alih (jika ada)
  admin         User?         @relation("AdminChatSessions", fields: [adminId], references: [id])
  pesan         ChatMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([adminId])
}

model ChatMessage {
  id            Int           @id @default(autoincrement())
  sessionId     String
  session       ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isFromUser    Boolean
  isFromAdmin   Boolean       @default(false)
  content       String
  timestamp     DateTime      @default(now())

  @@index([sessionId])
}

model StrukturOrganisasi {
  id          Int      @id @default(autoincrement())
  nama        String
  jabatan     String
  deskripsi   String?
  foto        String?
  urutan      Int      @default(0)
  isAktif     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProfilKelurahan {
  id            Int      @id @default(1)
  tentang       String
  visi          String
  misi          String
  poinPelayanan String?
  updatedAt     DateTime @updatedAt
}
